@startuml
' ER Diagram - System Obsługi Paczkomatów (z uwzględnieniem modułu zwrotów)
hide circle
skinparam linetype ortho
skinparam roundcorner 5

entity "User (tabela Users)" as user {
  * Id : INTEGER <<PK>>
  --
  * Name : VARCHAR(60)
  * Surname : VARCHAR(60)
  * Email : VARCHAR(255)
  * PhoneNumber : VARCHAR(20)
  * Role : VARCHAR(20) (Customer, Courier, Operator)
  Rank : INTEGER
  Latitude : DOUBLE
  Longitude : DOUBLE
}

entity "ParcelLocker" as locker {
  * Id : INTEGER <<PK>>
  --
  * Latitude : DOUBLE
  * Longitude : DOUBLE
  * Country : VARCHAR(100)
  * City : VARCHAR(100)
  * Street : VARCHAR(100)
  * PostalCode : VARCHAR(30)
  * Number : VARCHAR(20)
}

entity "Box" as box {
  * Id : INTEGER <<PK>>
  --
  * ParcelLockerId : INTEGER <<FK>>
  * Size : VARCHAR(30) <<BoxSize>>
  * Version : INTEGER
}

entity "Package" as package {
  * Id : INTEGER <<PK>>
  --
  BoxId : INTEGER NULL <<FK>>
  DestinationBoxId : INTEGER NULL <<FK>>
  * Status : VARCHAR(30) <<PackageStatus>>
  * SenderId : INTEGER <<FK>>
  * RecipientId : INTEGER <<FK>>
  CourierId : INTEGER <<FK>>
  OperatorId : INTEGER <<FK>>
  AcceptedAt : DATETIME NULL
  PreparedAt : DATETIME NULL
  ShippedAt : DATETIME NULL
  DeliveredAt : DATETIME NULL
  CollectedAt : DATETIME NULL
  ExpiredAt : DATETIME NULL
  * DepositDeadline : DATETIME
  DepositConfirmedAt : DATETIME NULL
  * Size : VARCHAR(30) <<BoxSize>>
  OriginalPackageId : INTEGER NULL <<FK>>
  PickupCode : VARCHAR(6) NULL
}

entity "Payment" as payment {
  * Id : INTEGER <<PK>>
  --
  * PackageId : INTEGER <<FK>>
  * PayerEmail : VARCHAR(255)
  * Amount : DECIMAL(10,2)
  * Status : VARCHAR(20) <<PaymentStatus>>
  ExternalReference : VARCHAR(100)
  * CreatedAt : DATETIME
  CompletedAt : DATETIME NULL
}

entity "PackageItem" as item {
  * Id : INTEGER <<PK>>
  --
  * PackageId : INTEGER <<FK>>
  * Name : VARCHAR(150)
  ReturnPackageId : INTEGER NULL <<FK>>
}

' Relacje standardowe
locker ||--o{ box : "ParcelLockerId"
box |o--o{ package : "BoxId"
box |o--o{ package : "DestinationBoxId"
user ||--o{ package : "SenderId"
user ||--o{ package : "RecipientId"
user |o--o{ package : "CourierId"
user |o--o{ package : "OperatorId"
package ||--o| payment : "PackageId"

' Relacje modułu zwrotów (rozszerzenie)
package ||--o{ package : "OriginalPackageId\n(zwroty)"
package ||--o{ item : "PackageId\n(pozycje zamówienia)"
package |o--o{ item : "ReturnPackageId\n(odesłanie towaru)"

@enduml
