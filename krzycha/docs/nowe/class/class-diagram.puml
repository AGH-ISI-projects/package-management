@startuml

left to right direction
skinparam linetype ortho
skinparam classAttributeIconSize 0

'--------------classes-----------------

together {
    abstract class AbstractPerson {
        +int Id
        +string Name
        +string Surname
        +string Email
        +string PhoneNumber
        +int? Rank
    }

    class User {
        +List<Package>? SentPackages
        +List<Package>? ReceivedPackages
    }

    class Courier {
        +double Latitude
        +double Longitude
        +List<Package>? Packages
    }

    class Operator {
        +List<Package>? Packages
    }
}

class Package {
    +int Id
    +BoxSize Size
    +int? BoxId
    +int? DestinationBoxId
    +PackageStatus Status
    +int SenderId
    +User Sender
    +int RecipientId
    +User Recipient
    +int? CourierId
    +Courier? Courier
    +int? OperatorId
    +Operator? Operator
    +Box? Box
    +Box? DestinationBox
    +Payment? Payment
    +int? OriginalPackageId
    +Package? OriginalPackage
    +ICollection<Package> ReturnDeliveries
    +ICollection<PackageItem> Items
    +bool IsReturn
    +bool HasReturns
    +bool AreAllItemsReturned
    +DateTime DepositDeadline
    +DateTime? DepositConfirmedAt
    +DateTime? AcceptedAt
    +DateTime? PreparedAt
    +DateTime? ShippedAt
    +DateTime? DeliveredAt
    +DateTime? CollectedAt
    +DateTime? ExpiredAt
    +string? PickupCode

    +PackageItem AddItem(string name)
    +void Accept()
    +void ConfirmDeposit()
    +void Prepare()
    +void Ship()
    +void Deliver() <<ExpiredAt = DeliveredAt + 48h>>
    +void Collect(string code)
    +void MarkAsReturned()
    +void Reject()
    +void Cancel()
    +void Expire() <<Accepted/Shipped/Delivered, po ExpiredAt>>
    +void AssignOperator(Operator operatorUser)
    +void AssignCourier(Courier courier)
}

class Payment {
    +int Id
    +int PackageId
    +Package Package
    +string PayerEmail
    +decimal Amount
    +PaymentStatus Status
    +string? ExternalReference
    +DateTime CreatedAt
    +DateTime? CompletedAt

    +void Complete()
    +void Fail()
}

class PackageItem {
    +int Id
    +int PackageId
    +Package Package
    +string Name
    +int? ReturnPackageId
    +Package? ReturnPackage
    +bool IsReturned
}

together {
    class Box {
        +int Id
        +int ParcelLockerId
        +ParcelLocker? ParcelLocker
        +List<Package>? Packages
        +BoxSize Size
        +int Version
    }

    class ParcelLocker {
        +int Id
        +double Latitude
        +double Longitude
        -{readonly} List<Box> _boxes
        +IReadOnlyList<Box> Boxes
        +string Country
        +string City
        +string Street
        +string PostalCode
        +string Number

        +Box CreateBox(BoxSize size)
        +void RemoveBox(int boxId)
    }
}

together {
    enum PackageStatus {
        Ordered
        Accepted
        Preparing
        Shipped
        Delivered
        Collected
        Rejected
        Cancelled
        Expired
        ReturnedToSender
    }

    enum BoxSize {
        Small
        Medium
        Large
    }

    enum PaymentStatus {
        Pending
        Completed
        Failed
    }
}

together {
    interface IPackageOrderService {
        +CreatePackageAsync(senderId, recipientId, originLockerId, destinationLockerId, size, items?) : Task<Package>
        +CancelPackageAsync(packageId, requestingUserId?) : Task
    }

    class PackageOrderService

    interface IPackageReturnService {
        +CreateReturnDeliveryAsync(originalPackageId, customerId, itemIds, originLockerId?, size?) : Task<Package>
        +GetAvailableItemsForReturnAsync(originalPackageId, customerId) : Task<IReadOnlyList<PackageItem>>
        +GetReturnDeliveriesForPackageAsync(originalPackageId) : Task<IReadOnlyList<Package>>
    }

    class PackageReturnService
}

together {
    interface IPackageRepository {
        +GetByIdAsync(id) : Task<Package?>
        +AddAsync(package) : Task
        +UpdateAsync(package) : Task
        +GetAllAsync() : Task<IEnumerable<Package>>
        +GetPackagesRequiringExpirationAsync() : Task<IEnumerable<Package>>
        +GetPackagesWithMissedDepositAsync() : Task<IEnumerable<Package>>
    }

    class PackageRepository

    interface INotificationService {
        +NotifyAsync(userId, message) : Task
    }
}

note bottom of IPackageRepository
  GetPackagesRequiringExpirationAsync():
  Accepted / Shipped / Delivered
  z ExpiredAt < now
end note

' ------------relations-------------

AbstractPerson <|-- User
AbstractPerson <|-- Courier
AbstractPerson <|-- Operator

User "1" <-- "0..*" Package : Sender
User "1" <-- "0..*" Package : Recipient
Courier "0..1" <-- "0..*" Package
Operator "0..1" <-- "0..*" Package

Package "1" --> "0..1" Box : Box
Package "1" --> "0..1" Box : DestinationBox

ParcelLocker "1" *-- "0..*" Box

Package "1" *-- "0..1" Payment
Package "1" *-- "0..*" PackageItem : Items
Package "0..1" <-- "0..*" Package : OriginalPackage / ReturnDeliveries
PackageItem "0..*" --> "0..1" Package : ReturnPackage

Package ..> PackageStatus
Package ..> BoxSize
Box ..> BoxSize
Payment ..> PaymentStatus

IPackageOrderService <|.. PackageOrderService
IPackageReturnService <|.. PackageReturnService
IPackageRepository <|.. PackageRepository

PackageOrderService --> IPackageRepository
PackageOrderService --> INotificationService
PackageReturnService --> IPackageOrderService
PackageReturnService --> IPackageRepository
PackageReturnService --> INotificationService

IPackageOrderService ..> Package
IPackageReturnService ..> PackageItem
IPackageRepository ..> Package

@enduml