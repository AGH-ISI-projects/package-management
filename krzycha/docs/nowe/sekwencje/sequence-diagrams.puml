' Every participant below is a real class from src/ (or the MySQL database / Hangfire
' itself), and every message is a real method call with the arguments the code passes.
' "Home.razor" is the Blazor page (src/PackageDeliverySystem.Web/Components/Pages/Home.razor)
' that drives the whole flow in the demo; it reads lists straight from DeliveryDbContext.
' Notifications always go through INotificationService.NotifyAsync - in Web that is
' BackgroundNotificationService, which only does
' BackgroundJob.Enqueue<EmailNotificationService>(s => s.NotifyAsync(userId, message)).

@startuml 01-order-and-payment
title 01 - Customer: send new package (order + payment)

actor "User\n(Sender)" as Sender
participant "Home.razor\n(Blazor)" as Web
participant "PackageOrderService" as OrderSvc
participant "PeopleService" as People
participant "BoxRepository" as BoxRepo
participant "PackageIntakeService" as IntakeSvc
participant "PackageRepository" as PkgRepo
participant "FakePaymentGateway\n(IPaymentGateway)" as Gateway
participant "BackgroundNotificationService\n(INotificationService)" as Notify
database "MySQL\n(DeliveryDbContext)" as DB

Sender -> Web: open page
Web -> DB: Db.ParcelLockers.Include(l => l.Boxes).ToListAsync()
DB --> Web: lockers
Web --> Sender: lockers and boxes

Sender -> Web: choose origin locker, destination locker,\nsize (Small/Medium/Large), recipient\nand items [name]
Web -> OrderSvc: CreatePackageAsync(senderId, recipientId,\noriginLockerId, destinationLockerId, size, items)
OrderSvc -> People: GetUserAsync(senderId)
People --> OrderSvc: sender / null
OrderSvc -> People: GetUserAsync(recipientId)
People --> OrderSvc: recipient / null

alt sender or recipient is null
    OrderSvc --> Web: throw ArgumentException\n"Sender not found" / "Recipient not found"
    Web --> Sender: error message
else both found
    OrderSvc -> BoxRepo: FindFreeBoxAsync(originLockerId, size)
    BoxRepo --> OrderSvc: originBox / null

    alt originBox is null
        OrderSvc --> Web: throw InvalidOperationException\n"No free {size} box at the chosen origin locker - pick another locker or size"
        Web --> Sender: error message
    else origin box found
        OrderSvc -> BoxRepo: FindFreeBoxAsync(destinationLockerId, size, originBox.Id)
        BoxRepo --> OrderSvc: destinationBox / null

        alt destinationBox is null
            OrderSvc --> Web: throw InvalidOperationException\n"No free {size} box at the chosen destination locker - pick another locker or size"
            Web --> Sender: error message
        else destination box found
            OrderSvc -> OrderSvc: new Package { Sender, Recipient, Size,\nBoxId, DestinationBoxId }\n(Status=Ordered, DepositDeadline=now+48h)\n+ package.Items.Add(item) for each item
            OrderSvc -> PkgRepo: AddAsync(package)
            PkgRepo -> DB: SaveChangesAsync()\n(INSERT Package + PackageItems(PackageId, Name))
            OrderSvc --> Web: package
            Web --> Sender: "Paczka #id została zamówiona"

            Sender -> Web: pay
            Web -> IntakeSvc: RequestPaymentAsync(packageId, payerEmail, amount)
            IntakeSvc -> PkgRepo: GetByIdAsync(packageId)
            PkgRepo --> IntakeSvc: package (with Payment)

            alt package.Payment.Status == Completed
                IntakeSvc --> Web: throw InvalidOperationException\n"This package has already been paid for."
            else no completed payment yet
                IntakeSvc -> Gateway: InitiatePaymentAsync(payerEmail, amount)
                Gateway --> IntakeSvc: externalReference
                IntakeSvc -> IntakeSvc: package.Payment = new Payment\n{ PayerEmail, Amount, ExternalReference }\n(Status=Pending)
                IntakeSvc -> PkgRepo: UpdateAsync(package)
                IntakeSvc --> Web: externalReference
            end

            Web -> IntakeSvc: ConfirmPaymentAsync(packageId)
            IntakeSvc -> PkgRepo: GetByIdAsync(packageId)
            PkgRepo --> IntakeSvc: package

            alt package.Payment is null
                IntakeSvc --> Web: throw InvalidOperationException\n"No payment was requested for this package."
            else Payment.Status == Completed
                IntakeSvc --> Web: return (nothing to do)
            else Pending
                IntakeSvc -> Gateway: GetPaymentStatusAsync(externalReference)
                Gateway --> IntakeSvc: Completed / Failed / Pending

                alt Completed
                    IntakeSvc -> IntakeSvc: payment.Complete()
                    IntakeSvc -> PkgRepo: UpdateAsync(package)
                    IntakeSvc -> Notify: NotifyAsync("system",\n"Payment for package {id} has been confirmed.")
                else Failed
                    IntakeSvc -> IntakeSvc: payment.Fail()
                    IntakeSvc -> PkgRepo: UpdateAsync(package)
                    note right of Web
                      a new RequestPaymentAsync is allowed
                      after a Failed payment
                    end note
                end
                IntakeSvc --> Web: OK
            end
        end
    end
end

note over BoxRepo, DB
  Both boxes stay reserved from Ordered until the package reaches
  Collected, Cancelled, Rejected, Expired or ReturnedToSender
  (BoxRepository.FindFreeBoxAsync skips boxes used by any other package).
  FakePaymentGateway always answers Completed.
end note

== cancel (sender or assigned operator, while Ordered / Accepted) ==
Sender -> Web: cancel (packageId)
Web -> OrderSvc: CancelPackageAsync(packageId, senderId)
OrderSvc -> PkgRepo: GetByIdAsync(packageId)
PkgRepo --> OrderSvc: package / null

alt package is null
    OrderSvc --> Web: throw ArgumentException\n"Package not found"
else requestingUserId is neither SenderId nor OperatorId
    OrderSvc --> Web: throw InvalidOperationException\n"User {id} is not authorized to cancel package {id}. ..."
else Status is not Ordered / Accepted
    OrderSvc -> OrderSvc: package.Cancel()\n(throws "Cannot cancel package in status ...")
    OrderSvc --> Web: InvalidOperationException
else OK
    OrderSvc -> OrderSvc: package.Cancel()\n(Status=Cancelled)
    OrderSvc -> PkgRepo: UpdateAsync(package)
    OrderSvc -> Notify: NotifyAsync("system",\n"Package {id} was cancelled by user {userId}.")
    OrderSvc -> Notify: NotifyAsync(sender.Email,\n"Your package #{id} has been cancelled.")
    OrderSvc --> Web: OK
    Web --> Sender: "Przesyłka #id została anulowana"
end

@enduml

@startuml 02-deposit-confirmation
title 02 - Courier: confirm deposit (or report it missing)

actor "Courier\n(doing locker rounds)" as Courier
participant "Home.razor\n(Blazor)" as Web
participant "PackageIntakeService" as IntakeSvc
participant "PackageRepository" as PkgRepo
participant "PeopleService" as People
participant "BackgroundNotificationService\n(INotificationService)" as Notify

note over Courier
  Any courier checking this locker can confirm -
  not necessarily the one later assigned to carry
  the package (AssignCourierAsync, diagram 04).
  The sender can NOT self-report this.
end note

alt package is physically in the box
    Courier -> Web: confirm deposit (packageId)
    Web -> IntakeSvc: ConfirmDepositAsync(packageId, courierId)
    IntakeSvc -> PkgRepo: GetByIdAsync(packageId)
    PkgRepo --> IntakeSvc: package / null (throw ArgumentException "Package not found")
    IntakeSvc -> People: GetCourierAsync(courierId)
    People --> IntakeSvc: courier / null (throw ArgumentException "Courier not found")
    IntakeSvc -> IntakeSvc: package.ConfirmDeposit()\n(throws if Status != Ordered\nor now > DepositDeadline)
    IntakeSvc -> PkgRepo: UpdateAsync(package)
    IntakeSvc -> Notify: NotifyAsync("system",\n"Courier {name} confirmed package {id} is in its box.")
    IntakeSvc --> Web: OK
else box is empty
    Courier -> Web: report missing (packageId)
    Web -> IntakeSvc: ReportMissingDepositAsync(packageId, courierId)
    IntakeSvc -> PkgRepo: GetByIdAsync(packageId)
    PkgRepo --> IntakeSvc: package
    IntakeSvc -> People: GetCourierAsync(courierId)
    People --> IntakeSvc: courier
    IntakeSvc -> IntakeSvc: package.Cancel()\n(Status=Cancelled)
    IntakeSvc -> PkgRepo: UpdateAsync(package)
    IntakeSvc -> Notify: NotifyAsync("system", "Package {id} was cancelled:\ncourier {name} found the box empty at pickup (sender's fault).")
    IntakeSvc --> Web: OK
end

== fallback: nobody confirms the deposit in time ==
queue "Hangfire recurring job\nrelease-missed-deposits" as Recurring
Recurring -> IntakeSvc: ProcessMissedDepositsAsync() (Cron.Minutely)
IntakeSvc -> PkgRepo: GetPackagesWithMissedDepositAsync()
PkgRepo --> IntakeSvc: Status == Ordered, DepositConfirmedAt == null,\nDepositDeadline < now
loop each package
    IntakeSvc -> IntakeSvc: package.Cancel()
    IntakeSvc -> PkgRepo: UpdateAsync(package)
    IntakeSvc -> Notify: NotifyAsync("system", "Package {id} was cancelled:\nnothing was deposited before the pickup window closed.")
end

@enduml

@startuml 03-operator-accept-reject
title 03 - Operator: accept or reject

actor Operator
participant "Home.razor\n(Blazor)" as Web
participant "PackageAcceptanceService" as AcceptSvc
participant "PackageRepository" as PkgRepo
participant "BoxRepository" as BoxRepo
participant "PeopleService" as People
participant "BackgroundNotificationService\n(INotificationService)" as Notify
database "MySQL\n(DeliveryDbContext)" as DB

Operator -> Web: open page
Web -> DB: Db.Packages.Include(...).ToListAsync()
DB --> Web: packages (page shows Accept / Reject for Ordered ones)

alt Accept
    Operator -> Web: accept (packageId, boxId)
    Web -> AcceptSvc: AcceptPackageAsync(packageId, operatorId, boxId)
    AcceptSvc -> PkgRepo: GetByIdAsync(packageId)
    PkgRepo --> AcceptSvc: package (with Payment) / null
    AcceptSvc -> AcceptSvc: checks: package found, Status == Ordered,\npackage.BoxId == boxId
    AcceptSvc -> BoxRepo: GetByIdAsync(boxId)
    BoxRepo --> AcceptSvc: box / null
    AcceptSvc -> AcceptSvc: check box.Size == package.Size
    AcceptSvc -> People: GetOperatorAsync(operatorId)
    People --> AcceptSvc: operator / null

    AcceptSvc -> AcceptSvc: package.Accept()\n(throws if DepositConfirmedAt is null\nor Payment.Status != Completed;\nsets AcceptedAt, ExpiredAt = AcceptedAt + 48h)
    AcceptSvc -> AcceptSvc: package.AssignOperator(operator)
    AcceptSvc -> PkgRepo: UpdateAsync(package)
    AcceptSvc -> Notify: NotifyAsync("system",\n"Package {id} has been accepted by operator {name}.")
    AcceptSvc --> Web: OK
else Reject
    Operator -> Web: reject (packageId)
    Web -> AcceptSvc: RejectPackageAsync(packageId, operatorId)
    AcceptSvc -> PkgRepo: GetByIdAsync(packageId)
    PkgRepo --> AcceptSvc: package
    AcceptSvc -> People: GetOperatorAsync(operatorId)
    People --> AcceptSvc: operator
    AcceptSvc -> AcceptSvc: package.Reject()\n(Status=Rejected; allowed from Ordered or Accepted)
    AcceptSvc -> PkgRepo: UpdateAsync(package)
    AcceptSvc -> Notify: NotifyAsync("system",\n"Package {id} has been rejected by operator {name}.")
    AcceptSvc --> Web: OK
end

note over AcceptSvc
  Errors: ArgumentException "Package not found" / "Box ID does not match
  the package's assigned box" / "Box not found" / "Operator not found";
  InvalidOperationException "Package is not in an orderable state" /
  "Package declared as {size} cannot be accepted into a {size} box"
end note

@enduml

@startuml 04-courier-pickup-delivery
title 04 - Courier: assign, pick up, deliver

actor Courier
participant "Home.razor\n(Blazor)" as Web
participant "PackageFulfillmentService" as FulfillSvc
participant "PackageRepository" as PkgRepo
participant "PeopleService" as People
participant "BackgroundNotificationService\n(INotificationService)" as Notify

== assign + pick up (one button in Home.razor: "Kurier: Odbierz i Wyślij") ==
Courier -> Web: pick up (packageId)
Web -> FulfillSvc: AssignCourierAsync(packageId, courierId)
FulfillSvc -> PkgRepo: GetByIdAsync(packageId)
PkgRepo --> FulfillSvc: package
FulfillSvc -> People: GetCourierAsync(courierId)
People --> FulfillSvc: courier / null (throw ArgumentException "Courier not found")
FulfillSvc -> FulfillSvc: package.AssignCourier(courier)\n(requires Status == Accepted)
FulfillSvc -> PkgRepo: UpdateAsync(package)
FulfillSvc -> Notify: NotifyAsync("system",\n"Package {id} has been assigned to courier {name}.")

Web -> FulfillSvc: ShipPackageAsync(packageId)
FulfillSvc -> PkgRepo: GetByIdAsync(packageId)
PkgRepo --> FulfillSvc: package
FulfillSvc -> FulfillSvc: package.Prepare()\n(Status=Preparing, PreparedAt=now)
FulfillSvc -> FulfillSvc: package.Ship()\n(Status=Shipped, ShippedAt=now,\nExpiredAt=ShippedAt+48h)
FulfillSvc -> PkgRepo: UpdateAsync(package)
FulfillSvc -> Notify: NotifyAsync("system", "Package {id} has been shipped.")
FulfillSvc --> Web: OK

== delivery ==
Courier -> Web: deliver (packageId)
Web -> FulfillSvc: DeliverPackageAsync(packageId)
FulfillSvc -> PkgRepo: GetByIdAsync(packageId)
PkgRepo --> FulfillSvc: package
FulfillSvc -> FulfillSvc: package.Deliver()\n(Status=Delivered, DeliveredAt=now,\nExpiredAt=DeliveredAt+48h, PickupCode = 6 digits)
FulfillSvc -> PkgRepo: UpdateAsync(package)
FulfillSvc -> Notify: NotifyAsync("system",\n"Package {id} has been delivered. Pickup code: {code}")
FulfillSvc --> Web: OK

note over FulfillSvc, PkgRepo
  No "destination box taken" branch: the destination box is reserved
  since the order (diagram 01). A Shipped package whose ExpiredAt passes
  (lost in transit) is expired by the expire-packages job (diagram 05).
end note

@enduml

@startuml 05-customer-collect-and-rate
title 05 - Customer: collect package and rate courier / sender

actor "User\n(Recipient)" as Recipient
participant "Home.razor\n(Blazor)" as Web
participant "PackageFulfillmentService" as FulfillSvc
participant "RatingService" as RatingSvc
participant "PackageRepository" as PkgRepo
participant "PeopleService" as People
participant "BackgroundNotificationService\n(INotificationService)" as Notify

Recipient -> Web: collect (packageId, pickup code)
Web -> FulfillSvc: CollectPackageAsync(packageId, userId, code)
FulfillSvc -> PkgRepo: GetByIdAsync(packageId)
PkgRepo --> FulfillSvc: package

alt package.RecipientId != userId
    FulfillSvc --> Web: throw InvalidOperationException\n"Only this package's recipient can collect it"
    Web --> Recipient: error
else wrong code or wrong status
    FulfillSvc -> FulfillSvc: package.Collect(code)\n(throws "Invalid pickup code"\nor "Cannot collect package in status ...")
    FulfillSvc --> Web: error
    Web --> Recipient: error
else OK
    FulfillSvc -> FulfillSvc: package.Collect(code)\n(Status=Collected, CollectedAt=now)
    FulfillSvc -> PkgRepo: UpdateAsync(package)
    FulfillSvc -> Notify: NotifyAsync("system", "Package {id} has been collected.")
    FulfillSvc --> Web: OK
    Web --> Recipient: "Paczka została odebrana"

    opt rate (only once Collected)
        note over Recipient, RatingSvc
          IRatingService is registered in Web and used by the CLI demo
          and test WF15; Home.razor has no rating button yet.
        end note
        Recipient -> RatingSvc: RateCourierAsync(packageId, raterUserId, score)
        RatingSvc -> RatingSvc: score in 1..5\n(else ArgumentOutOfRangeException)
        RatingSvc -> PkgRepo: GetByIdAsync(packageId)
        PkgRepo --> RatingSvc: package
        RatingSvc -> RatingSvc: Status == Collected, RecipientId == raterUserId,\nCourierId != null ("This package has no courier to rate")
        RatingSvc -> People: UpdateRankAsync(package.CourierId, score)

        Recipient -> RatingSvc: RateSenderAsync(packageId, raterUserId, score)
        RatingSvc -> PkgRepo: GetByIdAsync(packageId)
        PkgRepo --> RatingSvc: package
        RatingSvc -> People: UpdateRankAsync(package.SenderId, score)
    end
end

note over RatingSvc, People
  Rank is overwritten by each new rating, not averaged - there is no
  rating history table (see AbstractPerson.Rank).
end note

== fallback: recipient does not collect within 48 h ==
queue "Hangfire recurring job\nexpire-packages" as Recurring
participant "PackageAcceptanceService" as AcceptSvc
Recurring -> AcceptSvc: ProcessExpiredPackagesAsync() (Cron.Minutely)
AcceptSvc -> PkgRepo: GetPackagesRequiringExpirationAsync()
PkgRepo --> AcceptSvc: Accepted / Shipped / Delivered\nwith ExpiredAt < now
loop each package
    AcceptSvc -> AcceptSvc: package.Expire()\n(Status=Expired)
    AcceptSvc -> PkgRepo: UpdateAsync(package)
    AcceptSvc -> Notify: NotifyAsync("system",\n"Package {id} has been marked as EXPIRED due to inactivity.")
end

@enduml

@startuml 06-return-process
title 06 - Customer: return items (partial or full return)

actor "User\n(Recipient / Customer)" as Customer
participant "Home.razor\n(Blazor)" as Web
participant "PackageReturnService" as ReturnSvc
participant "PackageRepository" as PkgRepo
participant "BoxRepository" as BoxRepo
participant "PackageOrderService" as OrderSvc
participant "BackgroundNotificationService\n(INotificationService)" as Notify

== 1. items that can still be returned ==

note over Customer, Web
  Home.razor shows pkg.Items with item.IsReturned directly (checkboxes);
  the same list is available from the service:
end note
Customer -> ReturnSvc: GetAvailableItemsForReturnAsync(originalPackageId, customerId)
ReturnSvc -> PkgRepo: GetByIdAsync(originalPackageId)
PkgRepo --> ReturnSvc: originalPackage (with Items)

alt customerId != RecipientId
    ReturnSvc --> Customer: throw InvalidOperationException\n"Only the package recipient can query returnable items."
else recipient
    ReturnSvc --> Customer: Items where !item.IsReturned\n(ReturnPackageId == null)
end

== 2. create the return delivery ==

Customer -> Web: tick items [itemIds], "Zwróć"
Web -> ReturnSvc: CreateReturnDeliveryAsync(originalPackageId, customerId, itemIds)\n(optional: originLockerId, size)
ReturnSvc -> PkgRepo: GetByIdAsync(originalPackageId)
PkgRepo --> ReturnSvc: originalPackage

alt validation fails
    note over ReturnSvc
      In this order:
      - itemIds empty -> ArgumentException
      - package not found -> ArgumentException
      - RecipientId != customerId -> InvalidOperationException
      - Status != Collected -> InvalidOperationException
      - an item not in this package -> ArgumentException
      - an item already returned -> InvalidOperationException
      - BoxId / DestinationBoxId missing -> InvalidOperationException
    end note
    ReturnSvc --> Web: exception
    Web --> Customer: error message
else valid
    ReturnSvc -> BoxRepo: GetByIdAsync(originalPackage.DestinationBoxId)
    BoxRepo --> ReturnSvc: customer's box (ParcelLockerId)
    ReturnSvc -> BoxRepo: GetByIdAsync(originalPackage.BoxId)
    BoxRepo --> ReturnSvc: merchant's box (ParcelLockerId)

    note over ReturnSvc
      Roles and route are swapped:
      senderId = original RecipientId, recipientId = original SenderId,
      origin locker = originLockerId ?? customer's locker,
      destination locker = merchant's locker, size = size ?? original Size
    end note

    ReturnSvc -> OrderSvc: CreatePackageAsync(senderId, recipientId,\nreturnOriginLockerId, returnDestinationLockerId, returnSize)
    note right of OrderSvc
      same steps as diagram 01:
      GetUserAsync x2, FindFreeBoxAsync x2, AddAsync
    end note

    alt no free box (origin or destination)
        OrderSvc --> ReturnSvc: throw InvalidOperationException\n"No free {size} box at the chosen ... locker"
        ReturnSvc --> Web: exception (nothing marked, nothing saved)
        Web --> Customer: error message
    else boxes reserved
        OrderSvc --> ReturnSvc: returnPackage (Status=Ordered)
        ReturnSvc -> ReturnSvc: returnPackage.OriginalPackageId = originalPackage.Id
        loop each returned item
            ReturnSvc -> ReturnSvc: item.ReturnPackageId = returnPackage.Id
        end
        ReturnSvc -> PkgRepo: UpdateAsync(originalPackage)
        ReturnSvc -> PkgRepo: UpdateAsync(returnPackage)
        ReturnSvc -> Notify: NotifyAsync("system", "Return delivery {id} created\nfor package {id} with {n} item(s).")
        ReturnSvc --> Web: returnPackage
        Web --> Customer: "Utworzono przesyłkę zwrotną #id"
    end
end

== 3. from here on the return is an ordinary package ==

note over Customer, Notify #LightCyan
  <b>returnPackage is a normal Package in status Ordered</b>:
  payment, deposit, acceptance, transport and collection go through
  diagrams 01-05 unchanged.
end note
@enduml
